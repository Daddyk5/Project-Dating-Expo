# --- Neon-managed ---
# Filled automatically by `neon link` / `neon checkout` / `neon deploy`.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require
NEON_BRANCH=production
NEON_AUTH_BASE_URL=https://<endpoint>.neonauth.<region>.aws.neon.tech/neondb/auth
NEON_AUTH_JWKS_URL=https://<endpoint>.neonauth.<region>.aws.neon.tech/neondb/auth/.well-known/jwks.json
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=
NEON_FUNCTION_API_BASE_URL=

# --- App settings ---
CORS_ORIGIN=http://localhost:8081
PORT=8787
NODE_ENV=development
# ollama (local, default) | anthropic | neon-gateway (paid Neon plans)
AI_PROVIDER=ollama
ANTHROPIC_API_KEY=
# llama3.2:3b for ollama; e.g. claude-haiku-4-5-20251001 for anthropic
AI_MODEL=llama3.2:3b
OLLAMA_URL=http://localhost:11434
AI_REQUESTS_PER_HOUR=20
NEON_AI_GATEWAY_URL=
NEON_AI_GATEWAY_TOKEN=

# Neon "test" branch for vitest: neon connection-string test --pooled
TEST_DATABASE_URL=
