{
  "name": "kingxqueen",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "npm run start -w @kxq/app",
    "web": "npm run web -w @kxq/app",
    "android": "npm run android -w @kxq/app",
    "ios": "npm run ios -w @kxq/app",
    "dev:api": "npm run dev -w @kxq/api",
    "dev:app": "npm run web -w @kxq/app",
    "db:check": "npm run db:check -w @kxq/api",
    "db:generate": "npm run db:generate -w @kxq/api",
    "db:migrate": "npm run db:migrate -w @kxq/api",
    "seed": "npm run seed -w @kxq/api",
    "seed:reset": "npm run seed:reset -w @kxq/api",
    "test": "npm run test -w @kxq/api",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "e2e": "node e2e/signup-to-chat.mjs",
    "e2e:features": "node e2e/account-features.mjs",
    "screenshots": "node e2e/readme-screenshots.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@neon/config": "^1.8.2",
    "@neon/env": "^1.4.7",
    "eslint": "^9.34.0",
    "globals": "^16.3.0",
    "playwright": "^1.63.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.46.0"
  }
}
